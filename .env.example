# Database Settings
DATABASE_URL=sqlite:///./ecommerce_v5.db

# JWT & Security Settings
JWT_SECRET_KEY=replace_this_with_a_highly_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
PAYMENT_GATEWAY_URL=https://api.paymentgateway.com/v1/charge

# Application Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=true
